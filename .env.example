NODE_ENV=development
PORT=5188
DATABASE_PATH=./outputs/irent_ops.db
UPLOAD_DIR=./outputs/uploads
CORS_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=Lax
SESSION_TTL_SECONDS=28800

# Use only with the one-time `pnpm create-admin/create-user --username ...` commands, then unset.
ADMIN_INITIAL_PASSWORD=
USER_INITIAL_PASSWORD=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_SENDING_STALE_SECONDS=300
AGENT_CONTEXT_INCIDENT_LIMIT=30
# Optional: set this in production to make the target immutable from the dashboard.
LINE_TARGET_ID=
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-3.8-flash
