NODE_ENV=development
SERVE_FRONTEND=false
PORT=5188
DATABASE_PATH=./outputs/irent_ops.db
UPLOAD_DIR=./outputs/uploads
CORS_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=Lax
SESSION_TTL_SECONDS=28800
# Server-side source of truth for variance-of-Laplacian quality validation.
BLUR_THRESHOLD=100
# Enable only after the corresponding production model adapter is configured.
ORIENTATION_CHECK_ENABLED=false
CONDITION_CHECK_ENABLED=false
# Server-side only. Browsers call the Node backend, never this local service directly.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=60000

# Use only with the one-time `pnpm create-admin/create-user --username ...` commands, then unset.
ADMIN_INITIAL_PASSWORD=
USER_INITIAL_PASSWORD=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_SENDING_STALE_SECONDS=300
AGENT_CONTEXT_INCIDENT_LIMIT=30
# Optional: set this in production to make the target immutable from the dashboard.
LINE_TARGET_ID=
# Public HTTPS origin for LINE incident buttons (e.g. https://your-dashboard.example).
PUBLIC_DASHBOARD_URL=
LINE_ESCALATION_MINUTES=10
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-3.8-flash
