NODE_ENV=development
PORT=5188
DATABASE_PATH=./outputs/irent_ops.db
UPLOAD_DIR=./outputs/uploads
CORS_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=Lax
SESSION_TTL_SECONDS=28800

# Use only for the one-time `pnpm --dir backend create-admin` command, then unset.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
USER_EMAIL=
USER_INITIAL_PASSWORD=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_SENDING_STALE_SECONDS=300
AGENT_CONTEXT_INCIDENT_LIMIT=30
# Optional: set this in production to make the target immutable from the dashboard.
LINE_TARGET_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
