NODE_ENV=development
SERVE_FRONTEND=false
PORT=5188
DATABASE_PATH=./outputs/irent_ops.db
UPLOAD_DIR=./outputs/uploads
CORS_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins for temporary reverse proxies/tunnels.
# Example: https://your-random-host.trycloudflare.com
ADDITIONAL_TRUSTED_ORIGINS=
COOKIE_SAME_SITE=Lax
SESSION_TTL_SECONDS=28800
# Server-side source of truth for variance-of-Laplacian quality validation.
BLUR_THRESHOLD=100
# Enable only after the corresponding production model adapter is configured.
ORIENTATION_CHECK_ENABLED=false
CONDITION_CHECK_ENABLED=false
# Server-side only. Browsers call the Node backend, never this local service directly.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=60000
# Optional pretrained-only DamageNet candidate verification. Keep disabled on the
# current CPU-only deployment; enable on a separate GPU AI service.
QWEN_VLM_ENABLED=false
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
QWEN_DEVICE=cuda
QWEN_QUANTIZATION=4bit
QWEN_BATCH_SIZE=1
QWEN_STRUCTURED_JSON_VERSION=v3
QWEN_MIN_PIXELS=200704
QWEN_MAX_PIXELS=401408
QWEN_TIMEOUT_SECONDS=45

# Use only with the one-time `pnpm create-admin/create-user --username ...` commands, then unset.
ADMIN_INITIAL_PASSWORD=
USER_INITIAL_PASSWORD=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_SENDING_STALE_SECONDS=300
# Public HTTPS origin used only to build expiring LINE image URLs (no trailing slash).
PUBLIC_BASE_URL=
# Random server-only secret (at least 32 characters); never expose this value to clients.
LINE_IMAGE_SIGNING_SECRET=
LINE_IMAGE_URL_TTL_SECONDS=600
AGENT_CONTEXT_INCIDENT_LIMIT=30
# Optional: set this in production to make the target immutable from the dashboard.
LINE_TARGET_ID=
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-3.8-flash
