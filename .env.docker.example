# Copy this file to .env before running docker compose.
# Use absolute host paths. Forward slashes are the least surprising format on Windows.
KPTNET_ROOT=C:/path/to/kptnetv1
DAMAGENET_ROOT=C:/path/to/damagenetv1

IRENT_PORT=5188
AI_PORT=8000
AI_SERVICE_TIMEOUT_MS=60000
BLUR_THRESHOLD=100
SESSION_TTL_SECONDS=28800

PNP_NORMALIZED_FOCAL=1.2
PNP_RANSAC_REPROJECTION_PX=8
PNP_RANSAC_ITERATIONS=100

# Optional integrations. Keep real secrets only in the ignored .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_ID=
