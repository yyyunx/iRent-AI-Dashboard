{
  "name": "irent-ops-backend",
  "version": "1.0.0",
  "description": "iRent AI Dashboard TypeScript Express Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "create-admin": "ts-node src/cli/create-admin.ts",
    "create-user": "ts-node src/cli/create-user.ts",
    "test:security": "node --test -r ts-node/register test/security.integration.test.js",
    "test:line-webhook": "node --test -r ts-node/register test/line-webhook.integration.test.js",
    "test:laplacian": "node --test test/laplacian.unit.test.js",
    "test:performance": "node --test -r ts-node/register test/performance-monitor.unit.test.js",
    "benchmark:api": "node -r ts-node/register test/api-latency.benchmark.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
